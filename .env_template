# template for environment variables commonly used in this project

# api tokens

# Used by the backend directly and by the Vite frontend (mapped to 3D terrain setup).
MAPBOX_TOKEN=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=

# Auth (deployment only — leave blank for local dev to disable auth)
ACCESS_CODE=
SESSION_SECRET=

# Admin tools (#31 polygon editor)
# Set to "1" locally to expose admin-gated endpoints at /api/admin/*.
# Never enable in production — these routes can mutate site polygon
# overrides. Leave blank on Render so the admin routes return 404.
EEZ_ENABLE_ADMIN_TOOLS=
